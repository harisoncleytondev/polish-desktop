{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "polish-desktop",
  "version": "0.1.0",
  "identifier": "tech.harisoncleyton.polish-desktop",

  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },

  "app": {
    "windows": [
      {
        "title": "Polish | Aguardando seu texto..",
        "width": 800,
        "height": 600,
        "resizable": false,
        "maximizable": false,
        "fullscreen": false,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },

  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}